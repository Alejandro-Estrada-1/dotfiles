#!/usr/bin/env bash
# Muestra los atajos de Hyprland con su descripción.
# La lista sale de la configuración en vivo (hyprctl binds), así que siempre
# está al día con config/hypr/modulos/atajos.lua.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

if pgrep -x rofi >/dev/null; then
    pkill -x rofi
    exit 0
fi

hyprctl binds -j | jq -r '
    def mods:
        [ (if .modmask / 64 | floor % 2 == 1 then "Super" else empty end),
          (if .modmask / 4  | floor % 2 == 1 then "Ctrl"  else empty end),
          (if .modmask / 8  | floor % 2 == 1 then "Alt"   else empty end),
          (if .modmask      | floor % 2 == 1 then "Shift" else empty end) ];
    def tecla:
        { "mouse:272": "Clic izquierdo", "mouse:273": "Clic derecho",
          "mouse_down": "Rueda abajo", "mouse_up": "Rueda arriba",
          "Return": "Enter", "comma": ",", "period": ".", "Print": "Impr Pant" }[.key] // .key;
    .[] | select(.has_description) | [.description, ((mods + [tecla]) | join(" + "))] | @tsv' |
    awk -F'\t' '{ printf "%-38s %s\n", $1, $2 }' |
    rofi -dmenu -i -p "Atajos" -theme "$REPO/scripts/rofi/atajos.rasi" >/dev/null || true
