#!/usr/bin/env bash
# Aplica un tema: genera los archivos de color de cada programa a partir de
# temas/<familia>/<nombre>.tema + temas/plantillas/, y lo aplica en vivo si
# hay una sesión de Hyprland activa.
#
# Uso: dots-aplicar-tema <nombre>            (ej. green, anonymous-red)
#      dots-aplicar-tema <familia>/<nombre>  (ej. catppuccin/green)
#      dots-aplicar-tema --actual            (vuelve a aplicar el tema guardado)
#      dots-aplicar-tema --lista
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/tema-actual"
TEMA_POR_DEFECTO="catppuccin/green"

error() { echo "dots-aplicar-tema: $*" >&2; exit 1; }

listar() {
    find "$REPO/temas" -mindepth 2 -maxdepth 2 -name '*.tema' -printf '%P\n' |
        sed 's/\.tema$//' | sort
}

case "${1:-}" in
    --lista) listar; exit 0 ;;
    --actual) TEMA="$(cat "$ESTADO" 2>/dev/null || echo "$TEMA_POR_DEFECTO")" ;;
    "") error "falta el nombre del tema (usa --lista para verlos)" ;;
    *) TEMA="$1" ;;
esac

# Acepta "green" o "catppuccin/green"
if [[ "$TEMA" != */* ]]; then
    coincidencias=$(listar | grep -E "/${TEMA}\$" || true)
    [[ -z "$coincidencias" ]] && error "no existe el tema '$TEMA'"
    [[ $(wc -l <<<"$coincidencias") -gt 1 ]] && error "'$TEMA' es ambiguo: $(tr '\n' ' ' <<<"$coincidencias")"
    TEMA="$coincidencias"
fi
ARCHIVO_TEMA="$REPO/temas/$TEMA.tema"
[[ -f "$ARCHIVO_TEMA" ]] || error "no existe $ARCHIVO_TEMA"

# --- Paleta: valores por defecto (Catppuccin Mocha) y luego los del tema ---
FONDO="#1e1d2f"; FONDO_ALT="#282839"; FONDO_TERMINAL="#1e1e2e"; BLOQUEO_FONDO="#1e1e2e"
URGENTE="#f38ba8"; INFO="#89b4fa"; TERMINAL_COLOR0="#cdd6f4"
# shellcheck source=/dev/null
source "$ARCHIVO_TEMA"
: "${ACENTO:?el tema debe definir ACENTO}" "${FONDO_PANTALLA:?}" "${LOGO:?}" "${GTK:?}" "${CURSOR:?}"
: "${TEXTO:=$ACENTO}" "${BORDE:=$ACENTO}" "${SOMBRA:=$ACENTO}"
: "${WAYBAR_ACENTO:=$ACENTO}" "${WAYBAR_TEXTO:=$TEXTO}"
: "${URGENTE_TEXTO:=$URGENTE}" "${INFO_TEXTO:=$INFO}"
: "${BLOQUEO_TEXTO_ENTRADA:=$TEXTO}" "${TERMINAL_BRILLANTE:=$TEXTO}" "${CARPETAS:=}"
NOMBRE="$TEMA"
RUTA_FONDO_PANTALLA="$REPO/fondos/$FONDO_PANTALLA"
RUTA_LOGO="$REPO/config/fastfetch/logos/$LOGO"
[[ -f "$RUTA_FONDO_PANTALLA" ]] || error "no existe el fondo $RUTA_FONDO_PANTALLA"
[[ -f "$RUTA_LOGO" ]] || error "no existe el logo $RUTA_LOGO"

VARIABLES=(NOMBRE ACENTO TEXTO BORDE SOMBRA WAYBAR_ACENTO WAYBAR_TEXTO FONDO FONDO_ALT
           FONDO_TERMINAL BLOQUEO_FONDO BLOQUEO_TEXTO_ENTRADA URGENTE URGENTE_TEXTO INFO
           INFO_TEXTO TERMINAL_COLOR0 TERMINAL_BRILLANTE RUTA_FONDO_PANTALLA CURSOR GTK)

# {{VAR}} -> valor, {{VAR_HEX}} -> valor sin '#'
SED_ARGS=()
for v in "${VARIABLES[@]}"; do
    valor=$(printf '%s' "${!v}" | sed 's/[&|\\]/\\&/g')
    SED_ARGS+=(-e "s|{{${v}}}|${valor}|g" -e "s|{{${v}_HEX}}|${valor#\#}|g")
done

generar() { # plantilla destino
    local tmp
    mkdir -p "$(dirname "$2")"
    tmp=$(mktemp "$2.XXXXXX")
    sed "${SED_ARGS[@]}" "$REPO/temas/plantillas/$1" >"$tmp"
    if grep -q '{{' "$tmp"; then
        rm -f "$tmp"; error "quedaron variables sin reemplazar en $1"
    fi
    mv -f "$tmp" "$2"
}

generar hypr.lua      "$CFG/hypr/tema-actual.lua"
generar hyprlock.conf "$CFG/hypr/hyprlock.conf"
generar waybar.css    "$CFG/waybar/tema-actual.css"
generar rofi.rasi     "$CFG/rofi/tema-actual.rasi"
generar kitty.conf    "$CFG/kitty/tema-actual.conf"
ln -sfn "$RUTA_LOGO" "$CFG/fastfetch/logo-actual.png"

mkdir -p "$(dirname "$ESTADO")"
echo "$TEMA" >"$ESTADO"

# --- GTK, iconos y cursor ---
ini() { # archivo clave valor
    [[ -f "$1" ]] || { mkdir -p "$(dirname "$1")"; printf '[Settings]\n' >"$1"; }
    if grep -q "^$2=" "$1"; then sed -i "s|^$2=.*|$2=$3|" "$1"; else echo "$2=$3" >>"$1"; fi
}
for f in "$CFG/gtk-3.0/settings.ini" "$CFG/gtk-4.0/settings.ini"; do
    ini "$f" gtk-theme-name "$GTK"
    ini "$f" gtk-icon-theme-name Papirus-Dark
    ini "$f" gtk-cursor-theme-name "$CURSOR"
    ini "$f" gtk-cursor-theme-size 24
done
if command -v gsettings >/dev/null; then
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR" 2>/dev/null || true
fi
if [[ -n "$CARPETAS" ]] && command -v papirus-folders >/dev/null; then
    papirus-folders -C "$CARPETAS" >/dev/null 2>&1 || true
fi

# --- Aplicar en vivo (solo dentro de Hyprland) ---
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    awww img "$RUTA_FONDO_PANTALLA" --transition-type wipe --transition-duration 1 >/dev/null 2>&1 || true
    hyprctl setcursor "$CURSOR" 24 >/dev/null || true
    hyprctl reload >/dev/null || true
    pkill -USR1 -x kitty 2>/dev/null || true   # kitty recarga su config con SIGUSR1
    if pgrep -x waybar >/dev/null; then
        pkill -x waybar || true
        setsid -f waybar >/dev/null 2>&1
    fi
fi

echo "Tema aplicado: $TEMA"
