#!/usr/bin/env bash
# Audio visualizer for the Waybar "custom/cava" module.
# Runs cava with raw ASCII output and turns every frame into bar characters,
# so it works with the official waybar package (its built-in cava module only
# exists in the AUR waybar-cava build). The bars move while sound plays and
# stay flat in silence.
set -euo pipefail

bars="▁▂▃▄▅▆▇█"
config="${XDG_RUNTIME_DIR:-/tmp}/dots-cava.conf"

cat >"$config" <<EOF
[general]
framerate = 60
autosens = 1
bars = 8
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 59
frame_delimiter = 10
channels = mono
mono_option = average
reverse = 0

[smoothing]
monstercat = 1
waves = 1
noise_reduction = 77
EOF

# "0;3;7;..." -> "▁▄█..."
script="s/;//g;"
for i in {0..7}; do script+="s/$i/${bars:$i:1}/g;"; done

# sed replaces this shell, so when Waybar stops the module cava gets a broken
# pipe on its next frame and exits too (no leftover processes). Waybar ignores
# SIGPIPE and its children inherit that, so cava gets the default action back
# through env (bash itself cannot reset a signal ignored on entry).
exec sed -u "$script" < <(env --default-signal=PIPE cava -p "$config")
