#!/usr/bin/env python3
"""Media panel for the Waybar media button.

A small translucent panel under the bar with one tab per MPRIS player
(Spotify, a browser video, ...): album art, title, artist, progress and
previous / play-pause / next. Every player is controlled on its own.
Running it again (the bar button, a keybind) closes it, as do Esc and a
click outside the panel. Colors come from the active theme
(~/.config/dots-media/current-theme.css, generated by dots-apply-theme).
"""

# gtk4-layer-shell must be loaded before libwayland-client, so before gi
from ctypes import CDLL
CDLL("libgtk4-layer-shell.so")

import hashlib
import os
import threading
import urllib.request

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Playerctl", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Gtk4LayerShell as LayerShell, Playerctl  # noqa: E402

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "dots-media")

# Nerd Font icons, written as escapes so editors cannot drop them
ICON_MUSIC = "\U000F075A"
ICON_PREV = "\U000F04AE"
ICON_PLAY = "\U000F040A"
ICON_PAUSE = "\U000F03E4"
ICON_NEXT = "\U000F04AD"

ART_SIZE = 84


def interface_language():
    """Language chosen in install.sh (~/.config/dotfiles/settings)."""
    try:
        with open(os.path.join(CONFIG_HOME, "dotfiles", "settings"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("language="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return "en"


LANG = interface_language()


def L(en, es):
    return es if LANG == "es" else en


def format_time(microseconds):
    seconds = max(0, int(microseconds // 1_000_000))
    return f"{seconds // 60}:{seconds % 60:02d}"


def pretty_name(player):
    name = player.props.player_name or "?"
    return name[:1].upper() + name[1:]


class MediaPanel(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.dotfiles.MediaPanel")
        self.window = None
        self.manager = None
        self.selected = None
        self.art_url = None

    # A second launch reaches the running instance through D-Bus: close it
    def do_activate(self):
        if self.window is not None:
            self.quit()
            return
        self.load_css()
        self.build_window()
        self.setup_players()
        self.refresh()
        GLib.timeout_add_seconds(1, self.tick)
        self.window.present()

    # ---------- interface ----------
    def load_css(self):
        path = os.path.join(CONFIG_HOME, "dots-media", "style.css")
        if os.path.exists(path):
            provider = Gtk.CssProvider()
            provider.load_from_path(path)
            # Above ~/.config/gtk-4.0/gtk.css (USER priority): GTK themes paint every
            # window background, which would cover the whole screen behind the panel
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)

    def build_window(self):
        win = Gtk.ApplicationWindow(application=self)
        win.add_css_class("dots-media")
        LayerShell.init_for_window(win)
        LayerShell.set_namespace(win, "dots-media")
        # Overlay: above every window, fullscreen ones included
        LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.EXCLUSIVE)
        # Cover the screen (below the bar) so a click outside the panel closes it
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(win, edge, True)

        self.panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                             halign=Gtk.Align.END, valign=Gtk.Align.START)
        self.panel.add_css_class("panel")
        win.set_child(self.panel)

        self.tabs = Gtk.Box(spacing=6, homogeneous=False)
        self.tabs.add_css_class("tabs")
        self.panel.append(self.tabs)

        # Each state keeps its own height (the empty message is a single line)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               vhomogeneous=False, interpolate_size=True)
        self.panel.append(self.stack)

        empty = Gtk.Label(label=f"{ICON_MUSIC}  {L('Nothing playing', 'Nada reproduciéndose')}")
        empty.add_css_class("empty")
        self.stack.add_named(empty, "empty")

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        top = Gtk.Box(spacing=12)
        self.art = Gtk.Image(pixel_size=ART_SIZE, overflow=Gtk.Overflow.HIDDEN)
        self.art.set_size_request(ART_SIZE, ART_SIZE)
        self.art.add_css_class("art")
        self.art_placeholder = Gtk.Label(label=ICON_MUSIC)
        self.art_placeholder.add_css_class("art-placeholder")
        self.art_placeholder.set_size_request(ART_SIZE, ART_SIZE)
        self.art_stack = Gtk.Stack()
        self.art_stack.add_named(self.art_placeholder, "placeholder")
        self.art_stack.add_named(self.art, "art")
        top.append(self.art_stack)

        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
        self.title = Gtk.Label(xalign=0, ellipsize=3, max_width_chars=24)  # 3 = Pango END
        self.title.add_css_class("title")
        self.artist = Gtk.Label(xalign=0, ellipsize=3, max_width_chars=26)
        self.artist.add_css_class("artist")
        self.source = Gtk.Label(xalign=0)
        self.source.add_css_class("source")
        for widget in (self.title, self.artist, self.source):
            info.append(widget)
        top.append(info)
        card.append(top)

        self.progress = Gtk.ProgressBar()
        self.progress.add_css_class("progress")
        card.append(self.progress)
        times = Gtk.Box()
        self.position = Gtk.Label(xalign=0, hexpand=True)
        self.length = Gtk.Label(xalign=1)
        for widget in (self.position, self.length):
            widget.add_css_class("time")
            times.append(widget)
        card.append(times)

        controls = Gtk.Box(spacing=18, halign=Gtk.Align.CENTER)
        controls.add_css_class("controls")
        self.play_button = None
        for icon, action in ((ICON_PREV, "previous"), (ICON_PLAY, "play_pause"), (ICON_NEXT, "next")):
            button = Gtk.Button(label=icon)
            button.add_css_class("control")
            button.connect("clicked", self.on_control, action)
            controls.append(button)
            if action == "play_pause":
                self.play_button = button
        card.append(controls)
        self.stack.add_named(card, "player")

        click = Gtk.GestureClick()
        click.connect("pressed", self.on_click)
        win.add_controller(click)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)
        self.window = win

    def on_click(self, gesture, n_press, x, y):
        target = self.window.pick(x, y, Gtk.PickFlags.DEFAULT)
        if target is None or not (target == self.panel or target.is_ancestor(self.panel)):
            self.quit()

    def on_key(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        return False

    # ---------- players ----------
    def setup_players(self):
        self.manager = Playerctl.PlayerManager()
        self.manager.connect("name-appeared", lambda manager, name: (self.add_player(name), self.refresh()))
        self.manager.connect("player-vanished", lambda manager, player: self.refresh())
        for name in self.manager.props.player_names:
            self.add_player(name)

    def add_player(self, name):
        try:
            player = Playerctl.Player.new_from_name(name)
        except GLib.Error:
            return
        player.connect("playback-status", lambda *args: self.refresh())
        player.connect("metadata", lambda *args: self.refresh())
        self.manager.manage_player(player)

    def players(self):
        return list(self.manager.props.players) if self.manager else []

    def on_control(self, button, action):
        if self.selected is None:
            return
        try:
            getattr(self.selected, action)()
        except GLib.Error:
            pass

    def select(self, player):
        self.selected = player
        self.refresh()

    def refresh(self):
        players = self.players()
        if self.selected not in players:
            playing = [p for p in players if p.props.playback_status == Playerctl.PlaybackStatus.PLAYING]
            self.selected = (playing or players or [None])[0]

        # One tab per player, only when there is more than one
        child = self.tabs.get_first_child()
        while child is not None:
            following = child.get_next_sibling()
            self.tabs.remove(child)
            child = following
        for player in players:
            tab = Gtk.Button(label=pretty_name(player))
            tab.add_css_class("tab")
            if player == self.selected:
                tab.add_css_class("active")
            tab.connect("clicked", lambda button, p=player: self.select(p))
            self.tabs.append(tab)
        self.tabs.set_visible(len(players) > 1)

        if self.selected is None:
            self.stack.set_visible_child_name("empty")
            return False
        self.stack.set_visible_child_name("player")
        player = self.selected
        self.title.set_label(self.safe(player.get_title) or L("Unknown title", "Título desconocido"))
        self.artist.set_label(self.safe(player.get_artist) or "")
        self.artist.set_visible(bool(self.artist.get_label()))
        self.source.set_label(pretty_name(player))
        playing = player.props.playback_status == Playerctl.PlaybackStatus.PLAYING
        self.play_button.set_label(ICON_PAUSE if playing else ICON_PLAY)
        self.set_art(self.safe(lambda: player.print_metadata_prop("mpris:artUrl")) or "")
        self.tick()
        return False

    @staticmethod
    def safe(getter):
        try:
            return getter()
        except GLib.Error:
            return None

    def tick(self):
        if self.window is None:
            return False
        player = self.selected
        length = 0
        if player is not None:
            try:
                length = int(player.print_metadata_prop("mpris:length") or 0)
            except (GLib.Error, ValueError):
                length = 0
        if player is None or length <= 0:
            self.progress.set_visible(False)
            self.position.get_parent().set_visible(False)
            return True
        position = self.safe(player.get_position) or 0
        self.progress.set_visible(True)
        self.position.get_parent().set_visible(True)
        self.progress.set_fraction(min(1.0, position / length))
        self.position.set_label(format_time(position))
        self.length.set_label(format_time(length))
        return True

    # ---------- album art ----------
    def set_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        if url.startswith("file://"):
            self.show_art(Gio.File.new_for_uri(url).get_path())
        elif url.startswith(("http://", "https://")):
            path = os.path.join(CACHE_DIR, hashlib.sha1(url.encode()).hexdigest())
            if os.path.exists(path):
                self.show_art(path)
            else:
                self.art_stack.set_visible_child_name("placeholder")
                threading.Thread(target=self.download_art, args=(url, path), daemon=True).start()
        else:
            self.art_stack.set_visible_child_name("placeholder")

    def download_art(self, url, path):
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with urllib.request.urlopen(url, timeout=5) as response:
                data = response.read()
            with open(path, "wb") as f:
                f.write(data)
        except OSError:
            return
        GLib.idle_add(lambda: self.show_art(path) if url == self.art_url else None)

    def show_art(self, path):
        """Center-crops the image to a square and scales it (2x for HiDPI)."""
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
            side = min(pixbuf.get_width(), pixbuf.get_height())
            square = pixbuf.new_subpixbuf((pixbuf.get_width() - side) // 2,
                                          (pixbuf.get_height() - side) // 2, side, side)
            scaled = square.scale_simple(ART_SIZE * 2, ART_SIZE * 2, GdkPixbuf.InterpType.BILINEAR)
            _, png = scaled.save_to_bufferv("png", [], [])
            self.art.set_from_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(png)))
            self.art_stack.set_visible_child_name("art")
        except (GLib.Error, TypeError):
            self.art_stack.set_visible_child_name("placeholder")
        return False


if __name__ == "__main__":
    MediaPanel().run(None)
