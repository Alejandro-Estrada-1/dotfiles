#!/usr/bin/env bash
# Applies a theme: renders every program's color files from
# themes/<family>/<name>.theme + themes/templates/, and applies it live when
# a Hyprland session is running.
#
# Usage: dots-apply-theme <name>           (e.g. green, anonymous-red)
#        dots-apply-theme <family>/<name>  (e.g. catppuccin/green)
#        dots-apply-theme --current        (re-applies the saved theme)
#        dots-apply-theme --list
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$REPO/scripts/lib/common.sh"

CFG="$DOTS_CONFIG"
STATE_FILE="$DOTS_STATE/theme"
DEFAULT_THEME="catppuccin/green"

die() { echo "dots-apply-theme: $*" >&2; exit 1; }

list_themes() {
    find "$REPO/themes" -mindepth 2 -maxdepth 2 -name '*.theme' -printf '%P\n' |
        sed 's/\.theme$//' | sort
}

case "${1:-}" in
    --list) list_themes; exit 0 ;;
    --current) THEME="$(cat "$STATE_FILE" 2>/dev/null || echo "$DEFAULT_THEME")" ;;
    "") die "$(L "missing theme name (use --list to see them)" "falta el nombre del tema (usa --list para verlos)")" ;;
    *) THEME="$1" ;;
esac

# Accept "green" as well as "catppuccin/green"
if [[ "$THEME" != */* ]]; then
    matches=$(list_themes | grep -E "/${THEME}\$" || true)
    [[ -z "$matches" ]] && die "$(L "theme not found" "no existe el tema"): $THEME"
    [[ $(wc -l <<<"$matches") -gt 1 ]] && die "$(L "ambiguous name" "nombre ambiguo"): $(tr '\n' ' ' <<<"$matches")"
    THEME="$matches"
fi
THEME_FILE="$REPO/themes/$THEME.theme"
[[ -f "$THEME_FILE" ]] || die "$(L "file not found" "no existe el archivo"): $THEME_FILE"

# --- Palette: defaults (Catppuccin Mocha), then the theme's own values ---
BG="#1e1d2f"; BG_ALT="#282839"; TERMINAL_BG="#1e1e2e"; LOCK_BG="#1e1e2e"
URGENT="#f38ba8"; INFO="#89b4fa"; TERMINAL_COLOR0="#cdd6f4"
# shellcheck source=/dev/null
source "$THEME_FILE"
: "${ACCENT:?}" "${WALLPAPER:?}" "${LOGO:?}" "${GTK:?}" "${CURSOR:?}"
: "${TEXT:=$ACCENT}" "${BORDER:=$ACCENT}" "${SHADOW:=$ACCENT}"
: "${WAYBAR_ACCENT:=$ACCENT}" "${WAYBAR_TEXT:=$TEXT}"
: "${URGENT_TEXT:=$URGENT}" "${INFO_TEXT:=$INFO}"
: "${LOCK_INPUT_TEXT:=$TEXT}" "${TERMINAL_BRIGHT:=$TEXT}" "${FOLDERS:=}"
NAME="$THEME"
WALLPAPER_PATH="$REPO/wallpapers/$WALLPAPER"
# A wallpaper chosen with dots-wallpaper for this theme wins over the default
# (if that image was deleted, the default is used again)
custom=$(awk -F= -v t="$THEME" '$1 == t { sub(/^[^=]*=/, ""); p = $0 } END { print p }' \
             "$DOTS_CONFIG/dotfiles/wallpapers" 2>/dev/null || true)
[[ -n "$custom" && -f "$custom" ]] && WALLPAPER_PATH=$custom
LOGO_PATH="$REPO/config/fastfetch/logos/$LOGO"
[[ -f "$WALLPAPER_PATH" ]] || die "$(L "wallpaper not found" "no existe el fondo"): $WALLPAPER_PATH"
[[ -f "$LOGO_PATH" ]] || die "$(L "logo not found" "no existe el logo"): $LOGO_PATH"

# Interface texts used by the templates (swaync), in the language chosen in install.sh
T_NOTIFICATIONS=$(L "Notifications" "Notificaciones")
T_NO_NOTIFICATIONS=$(L "No notifications" "No hay notificaciones")
T_CLEAR_ALL=$(L "Clear all" "Borrar todo")
T_DND=$(L "Do not disturb" "No molestar")

VARIABLES=(NAME ACCENT TEXT BORDER SHADOW WAYBAR_ACCENT WAYBAR_TEXT BG BG_ALT TERMINAL_BG
           LOCK_BG LOCK_INPUT_TEXT URGENT URGENT_TEXT INFO INFO_TEXT TERMINAL_COLOR0
           TERMINAL_BRIGHT WALLPAPER_PATH CURSOR GTK
           T_NOTIFICATIONS T_NO_NOTIFICATIONS T_CLEAR_ALL T_DND)

# {{VAR}} -> value, {{VAR_HEX}} -> value without the leading '#',
# {{VAR_RGB}} -> "r, g, b" for #rrggbb colors
SED_ARGS=()
for v in "${VARIABLES[@]}"; do
    value=$(printf '%s' "${!v}" | sed 's/[&|\\]/\\&/g')
    SED_ARGS+=(-e "s|{{${v}}}|${value}|g" -e "s|{{${v}_HEX}}|${value#\#}|g")
    if [[ "${!v}" =~ ^#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})$ ]]; then
        rgb=$(printf '%d, %d, %d' "0x${BASH_REMATCH[1]}" "0x${BASH_REMATCH[2]}" "0x${BASH_REMATCH[3]}")
        SED_ARGS+=(-e "s|{{${v}_RGB}}|${rgb}|g")
    fi
done

render() { # template destination
    local tmp
    mkdir -p "$(dirname "$2")"
    tmp=$(mktemp "$2.XXXXXX")
    sed "${SED_ARGS[@]}" "$REPO/themes/templates/$1" >"$tmp"
    if grep -q '{{' "$tmp"; then
        rm -f "$tmp"; die "$(L "unreplaced variables in" "quedaron variables sin reemplazar en") $1"
    fi
    chmod 644 "$tmp"
    mv -f "$tmp" "$2"
}

render hypr.lua      "$CFG/hypr/current-theme.lua"
render hyprlock.conf "$CFG/hypr/hyprlock.conf"
render waybar.css    "$CFG/waybar/current-theme.css"
render rofi.rasi     "$CFG/rofi/current-theme.rasi"
render kitty.conf    "$CFG/kitty/current-theme.conf"
render swaync.css    "$CFG/swaync/current-theme.css"
render swaync-config.json "$CFG/swaync/config.json"
render media.css     "$CFG/dots-media/current-theme.css"
ln -sfn "$LOGO_PATH" "$CFG/fastfetch/current-logo.png"

mkdir -p "$DOTS_STATE"
echo "$THEME" >"$STATE_FILE"

# --- GTK, icons and cursor ---
set_ini() { # file key value
    [[ -f "$1" ]] || { mkdir -p "$(dirname "$1")"; printf '[Settings]\n' >"$1"; }
    if grep -q "^$2=" "$1"; then sed -i "s|^$2=.*|$2=$3|" "$1"; else echo "$2=$3" >>"$1"; fi
}
for f in "$CFG/gtk-3.0/settings.ini" "$CFG/gtk-4.0/settings.ini"; do
    set_ini "$f" gtk-theme-name "$GTK"
    set_ini "$f" gtk-icon-theme-name Papirus-Dark
    set_ini "$f" gtk-cursor-theme-name "$CURSOR"
    set_ini "$f" gtk-cursor-theme-size 24
done
# GTK 4 apps read ~/.config/gtk-4.0/gtk.css, which nwg-look sets as links to one
# theme; point them to the active theme's GTK 4 files (only when they are links)
gtk4_src="${XDG_DATA_HOME:-$HOME/.local/share}/themes/$GTK/gtk-4.0"
if [[ -d "$gtk4_src" ]]; then
    mkdir -p "$CFG/gtk-4.0"
    for f in gtk.css gtk-dark.css assets; do
        dst="$CFG/gtk-4.0/$f"
        if [[ -e "$gtk4_src/$f" ]] && { [[ -L "$dst" ]] || [[ ! -e "$dst" ]]; }; then
            ln -sfn "$gtk4_src/$f" "$dst"
        fi
    done
fi
if command -v gsettings >/dev/null; then
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR" 2>/dev/null || true
fi
# Papirus folder colors. papirus-folders runs sudo by itself when the icon
# theme is not writable. Without a terminal (Alt + C) that sudo cannot ask for
# the password and every attempt counts as a failed login: pam_faillock locks
# the account after 3. So it only runs when no password is needed or when
# there is a terminal to type it in.
papirus_writable() {
    local d
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}/icons/Papirus" "$HOME/.icons/Papirus" \
             /usr/local/share/icons/Papirus /usr/share/icons/Papirus; do
        [[ -f "$d/index.theme" ]] || continue
        [[ -w "$d/48x48/places/folder.svg" ]]
        return
    done
    return 1
}
if [[ -n "$FOLDERS" ]] && command -v papirus-folders >/dev/null; then
    if papirus_writable; then
        papirus-folders -C "$FOLDERS" >/dev/null 2>&1 || true
    elif [[ -t 0 && -t 1 ]]; then
        echo "$(L "The folder color needs administrator rights:" "El color de las carpetas requiere permisos de administrador:")"
        sudo papirus-folders -C "$FOLDERS" >/dev/null || true
    fi
fi

# --- Apply live ---
# Also when run outside the session (SSH, a TTY, dots-update) while this user's
# Hyprland is running: otherwise only the files would change, and what is on
# screen would no longer match the saved theme.
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -d "${XDG_RUNTIME_DIR:-}/hypr" ]]; then
    while read -r instance; do
        if [[ -S "$XDG_RUNTIME_DIR/hypr/$instance/.socket.sock" ]] &&
           HYPRLAND_INSTANCE_SIGNATURE=$instance hyprctl version >/dev/null 2>&1; then
            export HYPRLAND_INSTANCE_SIGNATURE=$instance
            break
        fi
    done < <(find "$XDG_RUNTIME_DIR/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' | sort -rn | cut -d' ' -f2)
fi
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    WAYLAND_DISPLAY=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-[0-9]*' -printf '%f\n' | sort | head -1)
    export WAYLAND_DISPLAY
fi
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    awww img "$WALLPAPER_PATH" --transition-type wipe --transition-duration 1 >/dev/null 2>&1 || true
    hyprctl setcursor "$CURSOR" 24 >/dev/null || true
    hyprctl reload >/dev/null || true
    pkill -USR1 -x kitty 2>/dev/null || true   # kitty reloads its config on SIGUSR1
    if pgrep -x swaync >/dev/null; then
        swaync-client --reload-config >/dev/null 2>&1 || true
        swaync-client --reload-css >/dev/null 2>&1 || true
    fi
    # Reload instead of restarting: a new waybar process makes some tray icons
    # (blueman) disappear until their app restarts; SIGUSR2 keeps them.
    pkill -USR2 -x waybar 2>/dev/null || true
fi

echo "$(L "Theme applied" "Tema aplicado"): $THEME"
